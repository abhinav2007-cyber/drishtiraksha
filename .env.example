# DRISHTIRAKSHA Environment Configuration
# Copy this file to .env and fill in values as needed.

# --- Backend ---
# Host and port for the FastAPI backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Database ---
# SQLite database file path (relative to backend/)
DATABASE_PATH=drishtiraksha.db

# --- Upload Limits ---
# Maximum upload file size in bytes (default: 50 MB)
MAX_UPLOAD_BYTES=52428800

# --- CORS ---
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:3000

# --- Evidence / Fact Checking ---
# Google Fact Check Tools API key (required for claim evidence retrieval)
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_FACT_CHECK_API_KEY=

# --- AI Models (future phases) ---
# Set to "cpu" or "cuda" — CUDA requires PyTorch with CUDA support
DEVICE=cpu

# Image deepfake detection model identifier (future)
# IMAGE_DETECTOR_MODEL=umm-maybe/AI-image-detector

# Audio deepfake detection model identifier (future)
# AUDIO_DETECTOR_MODEL=

# Multilingual sentence embedding model (future)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
